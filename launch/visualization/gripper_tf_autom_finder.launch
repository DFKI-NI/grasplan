<?xml version="1.0"?>
<launch>

  <!-- where the configuration is saved -->
  <arg name="yaml_path" default="$(find grasplan)/config/visualization/gripper_transformations.yaml" />
  <!-- the links and the end-effector link of the gripper to analyse -->
  <arg name="params_file" default="$(find grasplan)/config/visualization/gripper_tf_autom_finder_params.yaml" />

  <!-- automatically find all trasformations in the gripper to generate a config file out of it -->
  <node pkg="grasplan" type="gripper_tf_autom_finder.py" name="gripper_tf_autom_finder_node" output="screen" >
    <rosparam file="$(arg params_file)" command="load" />
    <!-- the path where to save the configuration in yaml format -->
    <param name="yaml_path" value="$(arg yaml_path)"/>
  </node>

</launch>
